# 复制为 .env 后按需修改（docker compose 与本地应用共用）
# 地址/账号/端口以《部署手册-中间件与数据》§2/§3 为唯一口径，勿改回 127.0.0.1 / localhost。
# 中间件连接（统一指向 192.168.20.88，端口用默认）
MYSQL_HOST=192.168.20.88
MYSQL_PORT=3306
MYSQL_ROOT_PASSWORD=123456
# 应用数据源凭据：占位符 ${MYSQL_USERNAME:xf} / ${MYSQL_PASSWORD:123456}，
# 可用同名环境变量覆盖（生产务必通过密钥管理注入，勿写回配置文件）。
MYSQL_USERNAME=xf
MYSQL_PASSWORD=123456
REDIS_HOST=192.168.20.88
REDIS_PORT=6379
REDIS_PASSWORD=123456
RABBITMQ_HOST=192.168.20.88
RABBITMQ_PORT=5672
RABBITMQ_USER=xf
RABBITMQ_PASS=123456
# 对应占位符 ${RABBITMQ_USERNAME:xf} / ${RABBITMQ_PASSWORD:123456}
RABBITMQ_USERNAME=xf
RABBITMQ_PASSWORD=123456
ES_URIS=http://192.168.20.88:9200
NACOS_SERVER=192.168.20.88:8848
# Nacos 3.x 镜像启动强校验（Base64≥32B）；首波鉴权 NACOS_AUTH_ENABLE=false
NACOS_AUTH_TOKEN=XAtoLkNhY29zRGljbGludGFrZW5Gb3JYZW5jeXByb3Zpc2lvbkEzMjE=
NACOS_AUTH_IDENTITY_KEY=nacos-server
NACOS_AUTH_IDENTITY_VALUE=nacos
# MinIO（根密码 ≥8 位）
MINIO_ENDPOINT=http://192.168.20.88:9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=itxinfei123

# 本地启动应用时覆盖 Nacos 地址（Spring relaxed binding）
#   SPRING_CLOUD_NACOS_DISCOVERY_SERVERADDR=${NACOS_SERVER}
#   SPRING_CLOUD_NACOS_CONFIG_SERVERADDR=${NACOS_SERVER}
