# 复制为 .env 后按需修改（docker compose 与本地应用共用）
# 中间件连接（本地 docker，应用跑在宿主机）
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_ROOT_PASSWORD=root
# 应用数据源凭据：已改为占位符 ${MYSQL_USERNAME:root} / ${MYSQL_PASSWORD:root}，
# 可用同名环境变量覆盖（生产务必通过密钥管理注入，勿写回配置文件）。
MYSQL_USERNAME=root
MYSQL_PASSWORD=root
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
RABBITMQ_HOST=127.0.0.1
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASS=guest
# 对应占位符 ${RABBITMQ_USERNAME:guest} / ${RABBITMQ_PASSWORD:guest}
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest
ES_URIS=http://127.0.0.1:9200
NACOS_SERVER=127.0.0.1:8848

# 本地启动应用时覆盖 Nacos 地址（Spring relaxed binding）
#   SPRING_CLOUD_NACOS_DISCOVERY_SERVERADDR=${NACOS_SERVER}
#   SPRING_CLOUD_NACOS_CONFIG_SERVERADDR=${NACOS_SERVER}
