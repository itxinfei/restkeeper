<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <parent>
        <artifactId>xfcy-service</artifactId>
        <groupId>com.restkeeper</groupId>
        <version>1.0-SNAPSHOT</version>
    </parent>
    <modelVersion>4.0.0</modelVersion>

    <artifactId>xfcy-service-job</artifactId>

    <dependencies>

        <dependency>
            <groupId>com.xuxueli</groupId>
            <artifactId>xxl-job-core</artifactId>
            <!-- 手册 §2 定版 XXL-Job：调度中心镜像 xxl-job-admin:3.5.0，core 必须同版（原 3.3.2 注册报 "accessToken or appname is empty"） -->
            <version>3.5.0</version>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jdbc</artifactId>
        </dependency>

        <dependency>
            <groupId>com.restkeeper</groupId>
            <artifactId>xfcy-common</artifactId>
            <version>1.0-SNAPSHOT</version>
            <scope>compile</scope>
        </dependency>
        <!-- 手册 §2 客户端配套：统一 Connector/J 9.x（groupId/版本由 Spring Boot BOM 管理） -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-web</artifactId>
        </dependency>
        <!-- job 需以 Web 容器方式启动（application.yml 配置了 server.port=8001），
             且 Nacos 自动注册依赖 WebServerInitializedEvent，缺 web starter 会导致注册 bean 创建失败 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <!-- 与全局统一：MyBatis-Plus 3.5.18.1 + Boot4 starter。
             旧版 3.3.0 的 extension/boot-starter 会拖入 Spring 5 时代的 mybatis-spring 2.0.3，
             其 SqlSessionFactoryBean 引用 Spring 7 已移除的 NestedIOException，导致 sqlSessionFactory 创建失败。 -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-spring-boot4-starter</artifactId>
        </dependency>

    </dependencies>

</project>