{
  "name": "microapp",
  "version": "0.1.0",
  "private": true,
  "description": "心飞餐饮 C 端点餐（Taro 4 + React 18 + TypeScript，微信小程序 / H5）",
  "scripts": {
    "dev:h5": "taro build --type h5 --watch",
    "build:h5": "taro build --type h5",
    "dev:weapp": "taro build --type weapp --watch",
    "build:weapp": "taro build --type weapp",
    "typecheck": "tsc --noEmit"
  },
  "browserslist": [
    "last 3 versions",
    "Android >= 4.1",
    "ios >= 8"
  ],
  "dependencies": {
    "@tarojs/components": "4.3.3",
    "@tarojs/plugin-framework-react": "4.3.3",
    "@tarojs/plugin-platform-h5": "4.3.3",
    "@tarojs/plugin-platform-weapp": "4.3.3",
    "@tarojs/react": "4.3.3",
    "@tarojs/router": "4.3.3",
    "@tarojs/runtime": "4.3.3",
    "@tarojs/shared": "4.3.3",
    "@tarojs/taro": "4.3.3",
    "@xfcy/api": "workspace:*",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@babel/preset-react": "^7.24.1",
    "@pmmmwh/react-refresh-webpack-plugin": "^0.5.17",
    "@tarojs/cli": "4.3.3",
    "@tarojs/webpack5-runner": "4.3.3",
    "@types/react": "^18.3.12",
    "babel-preset-taro": "4.3.3",
    "sass": "^1.83.0",
    "typescript": "~5.8.3"
  }
}
