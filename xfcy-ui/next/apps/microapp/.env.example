# 心飞餐饮 C 端点餐 · Taro 环境变量（复制为 .env 后生效，前缀固定 TARO_APP_）
# 说明：未创建 .env 时使用代码内默认值（mock 开、/microApp、15s）

# mock 模式开关：1 = 本地 mock（默认，4 页交互与原型一致）；0 = 调用真实后端
TARO_APP_USE_MOCK=1

# 真实模式 API 前缀（网关 microapp-web 路由 /microApp/**，见 deploy/nacos/gateway.yml）
TARO_APP_API_BASE_URL=/microApp

# 请求超时（毫秒）
TARO_APP_API_TIMEOUT=15000

# 真实模式本地联调：H5 devServer 代理目标（Node 环境变量，非 TARO_APP_ 前缀）
# TARO_APP_API_PROXY_TARGET=http://127.0.0.1:8080
